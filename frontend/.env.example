# NextAuth — local dev: use http://localhost:3000 (no path). Production: full URL including /isep if app is under /isep.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gUnaAV8KrALA1DqDa3XTznU44a00WuWMDwFaMZsaTYwQ=
# Optional (development only): set to 1 or true to enforce the SA/IH MFA middleware gate locally (default in dev is MFA off).
# NEXT_PUBLIC_REQUIRE_MFA_IN_DEV=1
# Optional: override app subpath (must match next.config basePath). Usually leave unset; base path is derived from NEXTAUTH_URL pathname.
# NEXT_PUBLIC_BASE_PATH=/isep

# Keycloak (isep-realm) — Docker exposes Keycloak on 8180
KEYCLOAK_CLIENT_ID=isep-web
# Must match the client secret in realm-isep.json (isep-web client). Required for token exchange (OAuthCallback).

# Must match isep-web client secret in Keycloak. When realm is imported from realm-isep.json, this value works as-is.
# To use a different secret: Keycloak Admin → Clients → isep-web → Credentials tab (do NOT use realm public_key).
# Optional: copy this line into .env.local to override .env. For curl/smoke tests, scripts/resolve-keycloak-client-secret.sh
# reads KEYCLOAK_CLIENT_SECRET from the environment, then .env.local, then .env, then the realm-import default.
KEYCLOAK_CLIENT_SECRET=CHANGE-ME-IMPORT-REPLACE-WITH-SECRET
KEYCLOAK_ISSUER=http://localhost:8180/realms/isep-realm
# Public Keycloak issuer (same value) — used for sign-out to also log out of Keycloak so next Sign in shows the login form
NEXT_PUBLIC_KEYCLOAK_ISSUER=http://localhost:8180/realms/isep-realm
# App URL for redirects (used by sign-out → Keycloak logout → redirect back here)
NEXT_PUBLIC_NEXTAUTH_URL=http://localhost:3000

# API base URL — meeting-service (and Kong if used) in DEV. Must be reachable from browser and server.
# If you see "fetch failed" or ERR_CONNECTION_REFUSED, start the backend or fix this URL (e.g. port 8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Y.js WebSocket URL (no trailing slash; y-websocket appends /{documentId}).
# Local Next dev: proxy /collab → y-websocket on 1234 (see next.config.js rewrites).
#   NEXT_PUBLIC_YJS_WS_URL=ws://localhost:3000/collab
# Or via API/Kong: ws://localhost:8000/collab
# Prod: wss://isep.dgs.gov.in/collab
NEXT_PUBLIC_YJS_WS_URL=ws://localhost:3000/collab
# Optional: HTTP origin for the collab rewrite target (default http://localhost:1234)
# YJS_WEBSOCKET_PROXY_TARGET=http://localhost:1234
# Optional: set to "true" to hide the "Backend API is unavailable" banner when using sample data in development
# NEXT_PUBLIC_HIDE_API_UNAVAILABLE_BANNER=true

# Optional: set to "true" to always show 60 sample meetings (Jan 2024–Dec 2025) when backend has no data
# NEXT_PUBLIC_USE_MOCK_MEETINGS=true

# Optional: Keycloak admin credentials for SCR-AUTH-03 (Change password). If not set, change-password API returns 503.
# KEYCLOAK_ADMIN_USERNAME=admin
# KEYCLOAK_ADMIN_PASSWORD=admin
