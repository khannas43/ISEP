{
  "name": "isep-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "next lint",
    "sonar": "docker run --rm -v \"$(pwd):/usr/src\" -w /usr/src -e SONAR_TOKEN --add-host=host.docker.internal:host-gateway sonarsource/sonar-scanner-cli -Dsonar.host.url=http://host.docker.internal:9010 -Dsonar.token=$SONAR_TOKEN",
    "sonar:native": "npx sonar-scanner -Dsonar.token=$SONAR_TOKEN",
    "dev:clean": "rm -rf .next && next dev -p 3000"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@tanstack/react-query": "^5.17.0",
    "@tiptap/extension-character-count": "^3.22.2",
    "@tiptap/extension-collaboration": "^3.22.2",
    "@tiptap/y-tiptap": "^3.0.2",
    "@tiptap/extension-highlight": "^3.22.2",
    "@tiptap/extension-placeholder": "^3.22.2",
    "@tiptap/extension-text-align": "^3.22.2",
    "@tiptap/pm": "^3.22.2",
    "@tiptap/react": "^3.22.2",
    "@tiptap/starter-kit": "^3.22.2",
    "diff": "^8.0.3",
    "diff-match-patch": "^1.0.5",
    "i18next": "^26.0.3",
    "i18next-resources-to-backend": "^1.2.1",
    "jose": "^6.1.3",
    "next": "14.2.0",
    "next-auth": "^4.24.5",
    "react": "^18.2.0",
    "react-calendar": "^5.0.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^15.0.0",
    "react-hook-form": "^7.49.0",
    "react-i18next": "^17.0.2",
    "y-websocket": "3.0.0",
    "yjs": "^13.6.30",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/diff-match-patch": "^1.0.36",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0"
  }
}
