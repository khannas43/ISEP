# Copy to .env.production and set values. Do not commit .env.production.
#   cp infrastructure/docker/.env.production.example infrastructure/docker/.env.production
# Then fill NEXTAUTH_SECRET and KEYCLOAK_CLIENT_SECRET (see below). Run:
#   docker compose -f infrastructure/docker/docker-compose.prod.yml --env-file infrastructure/docker/.env.production up -d

# App URL (no SSL — HTTP only). Include base path /isep.
PUBLIC_BASE_URL=http://148.230.66.191:3008/isep
PUBLIC_ORIGIN=http://148.230.66.191:3008
PUBLIC_HOST=148.230.66.191:3008

# --- Required: set these before first run ---

# 1) NEXTAUTH_SECRET — generate a random string (run once, paste below):
#    openssl rand -base64 32
NEXTAUTH_SECRET=

# 2) KEYCLOAK_CLIENT_SECRET — from Keycloak isep-web client. Either:
#    - Use the value from realm-isep.json (isep-web client secret), or
#    - After Keycloak is up: Admin → Realm isep-realm → Clients → isep-web → Credentials tab → copy "Client secret"
#    If realm was imported unchanged, it is often: CHANGE-ME-IMPORT-REPLACE-WITH-SECRET
KEYCLOAK_CLIENT_SECRET=

# Optional: when another app uses port 80, run ISEP nginx on this port (e.g. 8080); then proxy /isep from host nginx to this port.
NGINX_PORT=3008

# Optional: override default DB password (default: isep_prod_password)
# POSTGRES_PASSWORD=

# Optional: Keycloak admin (default: admin / admin)
# KEYCLOAK_ADMIN_PASSWORD=

# Backend JWT issuer must exactly match Keycloak token issuer.
KEYCLOAK_ISSUER_URI=http://148.230.66.191:3008/realms/isep-realm
