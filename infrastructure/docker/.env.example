# Copy to `.env` in this same folder (gitignored):  cp .env.example .env
# Compose loads `.env` from the project directory (the folder containing docker-compose.dev.yml).

# Host port for OpenSearch HTTP (default 9200). Use 9201 if another stack uses 9200 (e.g. ndip-opensearch).
OPENSEARCH_HOST_PORT=9201

# Host port for OpenSearch Dashboards (default 5601). Use 5602 if 5601 is taken.
OPENSEARCH_DASHBOARDS_HOST_PORT=5602

# Host port for meeting-service (default 8081). Use 8082 if local `mvn spring-boot:run` uses 8081.
MEETING_SERVICE_HOST_PORT=8082
